---
interface Props { title?: string; description?: string; pageClass?: string }
const { title = "Backplane", description = "An open workspace for agentic hardware development.", pageClass } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111410" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <main class={pageClass}><slot /></main>
    <footer><a href="https://backplane.works">backplane.works</a> · <a href="https://github.com/i2cjak/backplane">source</a></footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: dark; background: #111410; color: #e6e9de; --text: #e6e9de; --text-muted: #a7afa0; --border: #555b50; --surface: #1a1e17; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; line-height: 1.7; }
  main { max-width: 1000px; margin: auto; padding: 64px 24px; min-height: calc(100svh - 80px); }
  h1, h2, h3 { font-weight: 500; line-height: 1.25; letter-spacing: -.04em; }
  a { color: inherit; text-underline-offset: .2em; }
  a:hover { color: #d6edaf; }
  :focus-visible { outline: 2px solid #d6edaf; outline-offset: 4px; }
  footer { padding: 24px; text-align: center; font-size: 12px; color: #a7afa0; }
  button, input { font: inherit; border-radius: 0; }
  .btn { display: inline-block; padding: 12px 20px; border: 1px solid #555b50; text-decoration: none; }
  .btn-primary { background: #e6e9de; color: #111410; }
</style>
