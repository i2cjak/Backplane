import Base
import ./check.bend as C
import ../src/core/qr.bend as Q
import ../src/core/client.bend as U

# QR codes for pairing (core/qr.bend): each matrix is the reference
# encoder's (python-qrcode, byte mode, level M) for the same mask, and
# decoders read them (checked with zxing when this was written)

def rows(+t: String, +m: U32) -> String:
  String.join(Q.Qr.rows.with(t, Some{m}), "\n")

def nums(xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}:
      ""
    case +x <> t:
      U32.show(x) ++ " " ++ nums(t)

def main() -> IO(Unit):
  do IO<Unit>:
    C.Check.str("codewords", nums(Q.Qr.codewords(1, [65])), "64 20 16 236 17 236 17 236 17 236 17 236 17 236 17 236 107 112 244 24 163 122 17 95 52 252 ")
    C.Check.str("hello mask 3", rows("hello", 3), "111111101000001111111\n100000101000001000001\n101110100101001011101\n101110101010101011101\n101110100111001011101\n100000100111101000001\n111111101010101111111\n000000001111100000000\n101101110101101001011\n111010010011111001101\n110111101101000000011\n110101000111001111010\n010100111100100100001\n000000001011001000100\n111111101011100100000\n100000101010000111110\n101110100000111111111\n101110101011001011110\n101110101000101100100\n100000100000010110001\n111111101110010100100")
    C.Check.str("link mask 5", rows(Q.Qr.link("http://100.101.102.103:3787/#token=0123456789abcdef0123456789abcdef"), 5), "11111110010000111100101001001100101111111\n10000010111101000010011010000000101000001\n10111010110000111001000000110001001011101\n10111010100010001010000000110100101011101\n10111010000001011001010110100011001011101\n10000010001000000000110000000000101000001\n11111110101010101010101010101010101111111\n00000000101101010010100110111000000000000\n10000010101001100100101001100110011001110\n00010000001110101001001100110101010010110\n01011010000011101110001000010100010110110\n11100000100000110010101000100011110101001\n00111011110100010011101100111010101101001\n00001101110111011000101011101001101011101\n00011011101110011111011000000000010011100\n00010000100110011001000010010010001010110\n11010010011011101111101011101110100101101\n00000001111101001101000101010001001110101\n01001011101011101001011100010001100000011\n00001000010001000110001111011011001001011\n11100011011000011000010000110010110000101\n11111100000001011011110111111111110111100\n00011111110010011010111010010110010111100\n10010001000110000011100110110010000000001\n00000011100010100010001000010011111000010\n11110000010101110001111100111011111010011\n01101011111001110110010000011010110001010\n01011000110011101000101100110000100101111\n00011110010110000101100111001110000100100\n11001101001010100000001000100001101010001\n11101111000010000101000011110101000110101\n10000101000010001010000100100001000010000\n10000011110100000110100111111110111111100\n00000000101101010001110100111101100011100\n11111110000100110010001010010101101011010\n10000010011100101000010110111110100011001\n10111010001101010111110101110101111111010\n10111010010011010001010110110111010000110\n10111010001000100110111001010100011110000\n10000010000011000001000110101001001100101\n11111110111111000110001001010110000011100")
    C.Check.str("version 7 mask 2", rows("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", 2), "111111100000100001010111010101100100101111111\n100000100100000100000101111111001101001000001\n101110101110101110101000101010011101001011101\n101110101100000101111010000000110001101011101\n101110101000101111011111110101100011101011101\n100000101101100001001000111111001000001000001\n111111101010101010101010101010101010101111111\n000000001110100000001000101010011110000000000\n101111100000010101001111100000110101001111100\n000000000001111110101111010101100001110100011\n010000110000000000000101111111001010111110110\n111001000111000000100000101010011110001011100\n110000100111110111100010000000110101000001001\n001110000011011111001111010101100001110100011\n101010110100111100011101111111001010111110110\n000001011011000110110000101010011110001011100\n110110110101111011100010000000110101000001001\n110101010011011101001111010101100001110100011\n011100100100100000011101111111001010111110110\n111101001011001000110000101010011110001011100\n011111111100111111101111100000110101111111001\n101110001011001111001000110101100001100010011\n010110101011010000101010111111001011101010110\n010110001010011011111000101010011110100011100\n111111111101000110111111100000110100111111001\n001100010001110111111010010101100000100000011\n010110111010110000000111011111001011010100110\n010110000100011010100101101010011111011111100\n111101101110000010011000100000110100101011001\n001000001101110111011010010101100000100000011\n000010110010000001100111011111001011010100110\n101110001100101000100101101010011111011111100\n010111101110000000111000100000110100101011001\n011000001111110001011010010101100000100000011\n000010110010001111100111011111001011010100110\n011110001100110110100101101010011111011111100\n100110111110011000111111100000110100111111001\n000000001110000101011000110101100000100010011\n111111100001001100111010111111001010101010110\n100000101101000010011000101010011110100011100\n101110101011001001001111100000110101111111001\n101110101001000100100000110101100001001010011\n101110101000101100001010011111001011100000110\n100000100111100010011111001010011110110101100\n111111101010101001010101100000110100011111010")
    C.Check.str("link", Q.Qr.link("http://100.101.102.103:3787/#token=ab"), "backplane://pair?url=http://100.101.102.103:3787/%23token=ab")
    C.Check.str("link escapes", Q.Qr.link("http://h:1/#token=a b&c"), "backplane://pair?url=http://h:1/%23token=a%20b%26c")
    C.Check.str("versions", U32.show(Q.Qr.version(84)) ++ " " ++ U32.show(Q.Qr.version(85)) ++ " " ++ U32.show(Q.Qr.version(2331)) ++ " " ++ U32.show(Q.Qr.version(2332)), "5 6 40 0")
    C.Check.str("best decodes alike", U32.show(U32.from_nat(List.length(&2, String, Q.Qr.rows("hello")))), "21")
    C.Check.str("empty", Q.Qr.text(""), "")
    C.Check.str("path", Q.Qr.path(["0110", "1001"]), "M5 4h2v1h-2zM4 5h1v1h-1zM7 5h1v1h-1z")
    C.Check.str("client rows", String.join(U.Pair.qr(Map.set(&2, String, Map.new(&2, String), "pair.qr", "101\n010")), "|"), "101|010")
    C.Check.str("client none", U32.show(U32.from_nat(List.length(&2, String, U.Pair.qr(Map.new(&2, String))))), "0")
