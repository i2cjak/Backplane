{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backplane supplied release artifact inputs",
  "description": "Envelope schema; semantic component/native receipt validation is enforced by the CLI and documented in RELEASE-PRODUCER.md. This schema is not platform evidence.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "release",
        "shell",
        "electron",
        "service"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-electron-release-inputs"
        },
        "target": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "windows-x64"
          ]
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "shell": {
          "$ref": "#/$defs/component"
        },
        "electron": {
          "$ref": "#/$defs/component"
        },
        "service": {
          "$ref": "#/$defs/component"
        },
        "selectedBrowser": {
          "$ref": "#/$defs/selectedBrowser"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "release",
        "web",
        "emissionReceipt"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-web-release-inputs"
        },
        "target": {
          "const": "web"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "web": {
          "$ref": "#/$defs/component"
        },
        "emissionReceipt": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "target",
        "stageReceiptSha256",
        "payloadManifestSha256",
        "signing",
        "sandbox",
        "lifecycle",
        "runtimeAcceptance"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-desktop-target-acceptance"
        },
        "target": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "windows-x64"
          ]
        },
        "stageReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payloadManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signing": {
          "$ref": "#/$defs/artifact"
        },
        "sandbox": {
          "$ref": "#/$defs/artifact"
        },
        "lifecycle": {
          "$ref": "#/$defs/artifact"
        },
        "runtimeAcceptance": {
          "$ref": "#/$defs/artifact"
        },
        "selectedBrowserRuntime": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "scope",
        "target",
        "stageReceiptSha256",
        "payloadManifestSha256",
        "baseline",
        "selectedBrowserRuntime"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "target": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "windows-x64"
          ]
        },
        "stageReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payloadManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "const": "backplane-desktop-browser-composite-acceptance"
        },
        "scope": {
          "const": "retained-native-baseline+selected-browser"
        },
        "selectedBrowserRuntime": {
          "$ref": "#/$defs/artifact"
        },
        "baseline": {
          "type": "object",
          "required": [
            "desktop",
            "freeze",
            "proofs"
          ],
          "properties": {
            "desktop": {
              "$ref": "#/$defs/artifact"
            },
            "freeze": {
              "$ref": "#/$defs/artifact"
            },
            "proofs": {
              "type": "object",
              "required": [
                "signing",
                "sandbox",
                "lifecycle",
                "runtimeAcceptance"
              ],
              "properties": {
                "signing": {
                  "$ref": "#/$defs/artifact"
                },
                "sandbox": {
                  "$ref": "#/$defs/artifact"
                },
                "lifecycle": {
                  "$ref": "#/$defs/artifact"
                },
                "runtimeAcceptance": {
                  "$ref": "#/$defs/artifact"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "directory"
          ]
        },
        {
          "required": [
            "archive"
          ]
        }
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "$ref": "#/$defs/artifact"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "receipt",
        "payload"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "tag",
        "channel",
        "commit",
        "tree",
        "freezeReceipt"
      ],
      "properties": {
        "version": {
          "const": "0.12.0"
        },
        "tag": {
          "const": "v0.12.0"
        },
        "channel": {
          "const": "release"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "freezeReceipt": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "residentLifecyclePolicy": {
      "type": "object",
      "required": [
        "mode",
        "managedStop",
        "managedUpdate"
      ],
      "properties": {
        "mode": {
          "const": "resident-service"
        },
        "managedStop": {
          "const": false
        },
        "managedUpdate": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "releaseFreeze": {
      "type": "object",
      "description": "Root-approved freeze artifact referenced by each request; full identity/component/config semantic checks remain enforced by CLI.",
      "required": [
        "schema",
        "kind",
        "status",
        "version",
        "tag",
        "channel",
        "commit",
        "tree",
        "components",
        "sourceDateEpoch",
        "signingPolicy"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "backplane-release-freeze"
        },
        "status": {
          "const": "FROZEN"
        },
        "version": {
          "const": "0.12.0"
        },
        "tag": {
          "const": "v0.12.0"
        },
        "channel": {
          "const": "release"
        },
        "lifecyclePolicy": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "linux-x64",
              "linux-arm64",
              "darwin-arm64",
              "windows-x64"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/residentLifecyclePolicy"
          }
        },
        "selectedBrowser": {
          "type": "object",
          "description": "Optional exact root-pinned generated-web-only successor; CLI requires both-or-neither request, exact source/receipt/manifest/root disposition, and preserves original native/resource web receipts."
        }
      }
    },
    "selectedBrowser": {
      "type": "object",
      "required": [
        "receipt",
        "payload",
        "rootDisposition"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "rootDisposition": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    }
  }
}
