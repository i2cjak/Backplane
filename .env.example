# Optional: Backplane Connect source builds
# Cloud features are disabled by default. Configure your own Clerk and relay
# deployment to enable them. Local and direct remote connections need neither.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# BACKPLANE_CLERK_PUBLISHABLE_KEY=
# BACKPLANE_CLERK_JWT_TEMPLATE=backplane-relay
# BACKPLANE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in BACKPLANE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# BACKPLANE_APPLE_TEAM_ID=ABC1234567
# BACKPLANE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/backplane.provisionprofile
# BACKPLANE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# BACKPLANE_RELAY_URL=https://your-relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.backplane.works; override to test against a staging deployment.
# BACKPLANE_HOSTED_APP_URL=https://nightly.app.backplane.works

# Public, ingest-only mobile OpenTelemetry configuration.
# BACKPLANE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# BACKPLANE_MOBILE_OTLP_TRACES_DATASET=backplane-mobile-traces-dev
# BACKPLANE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
